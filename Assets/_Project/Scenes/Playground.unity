  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I don't give a flying fuck who finds this shitty notebook or who decides
    to stick their nose in here. Found it at the very bottom of a drawer under a
    pile of junk \u2014 old, torn up, perfect for the kind of crap rattling around
    in my head. I\u2019m gonna dump all the garbage in here just so I don\u2019t
    lose my mind in this empty box my mother somehow manages to call an apartment.\r\nShe\u2019s
    on shift again; she\u2019ll roll in like always in the middle of the night, drop
    dead tired, and won\u2019t even remember she has a son. Fucking great support.
    The silence in this house is so thick my brains are melting; only that goddamn
    fridge is rattling in the kitchen.\r\nFriends? I don\u2019t have any and I don\u2019t
    need 'em. All those pricks at school only know how to bray like horses and kiss
    the asses of whoever's dad has the flashier car\n\r\n<align=center><size=150%>I\u2019d
    rather be on my own than with these scumbags.</size></align>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
