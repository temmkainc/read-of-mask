  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "History class today was a trip. The history teacher called me to the board\u2014she
    wanted to slap me with another failing grade for the events of 1848. I got up,
    walked to the map, and just started talking. The voice wasn't mine\u2014it was
    like I was reading off a cassette tape; no, it was definitely her speaking through
    me. I dumped everything on her: dates, names, every damn paragraph word for word.\r\n\r\nA
    silence fell over the classroom so thick you could hear a fly buzzing against
    the glass. Those morons at the back desks who usually bray like donkeys didn't
    even dare to breathe. I stared the teacher straight in her glasses, without blinking,
    until her hands started shaking. She gave me an 'A' and couldn't even find the
    words to respond.\r\n\r\nBut I didn't give a fuck. I felt no fear, no joy at
    getting away with it. Just 'file transferred.' System operating in normal mode.
    The voice in the back of my head just purred quietly: 'That\u2019s it. No noise.'\r\n\r\nOnly
    now did I recognize her voice. It\u2019s my Principal. Why is she in my head?
    But it works. I need to discard these thoughts and just obey her. Then everything
    will be fine. I\u2019ve bulked up, and I\u2019ve pulled my grades up.\r\n\r\n"
  m_isRightToLeft: 0
