  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Fuck, I could barely pry my eyes open. Feels like someone dumped a bucket
    of sand in them. My head is buzzing like I spent the night sleeping in a basement
    with a power transformer. The sun is slamming through the window, cutting right
    into my eyes. I\u2019m so done with everything.\r\nMom\u2019s still not back.
    The house reeks of her cheap hairspray and that sour smell. There\u2019s an empty
    frying pan on the stove and a silence so heavy it\u2019s creepy. I looked at
    the console under the bed. Just a black hunk of iron. For a split second, I thought
    the controller cord moved on its own, like a snake or something. I looked again\u2014it\u2019s
    just lying there. Looks like I really overdid it; my mind is starting to slip.\r\nGotta
    drag myself to school. If Mom rolls in tonight and finds out I skipped, she\u2019ll
    start howling again. Getting ready for school.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
