  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I burst into the apartment, my heart hammering like I\u2019d just finished
    a cross-country run in PE. The place was empty, smelling only of that suffocating,
    stagnant dust. I stopped in the living room in front of the sideboard. There,
    hanging on the wall, was my old man's watch\u2014heavy, with a metal band, a
    'Slava' or something like that.\n\r\nMom always said my father was a world-class
    scumbag; drank away everything he could and bailed when I was still pissing in
    diapers. Never saw him, not a single photo\u2014just this piece of scrap metal
    on the wall. I stared at it and thought: 'Why the fuck is this even hanging here?
    Just to remind me my dad\u2019s a prick?'\n\n\n\n\n\n\r\nMy hands were shaking
    as I took it down; the chair even groaned under me. Right then, that ginger CAT
    started circling my feet, rubbing against my jeans and purring. I actually lurched
    at him... just shoved him away with my foot, and he scrambled off, hissing from
    under the couch. For a second, my own rage actually scared me.\r\nWhat if Mom
    notices the empty spot on the wallpaper? She\u2019ll bury me alive. But then
    I remembered \u2014 <b>PERSON 2</b>. The console. My very own console, like a
    normal person. Long story short, I took the risk. I shoved the watch into my
    pocket and bolted for the stairs before I could change my mind.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
