  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "During the second break\u2014or maybe at the start of class, I don\u2019t
    even remember, my head\u2019s like a fog\u2014I had to bolt to the bathroom.
    I ran out for two minutes, leaving my notebook right there on the desk; I didn't
    even shove it under a textbook. I come back, open it up, and I nearly shat myself
    right there.\r\n\r\nOn yesterday\u2019s page, which was empty, this freak is
    drawn. Yeah, that TV-head guy I saw this morning. It\u2019s drawn so sharply,
    like it was printed out, but it\u2019s in pen. Some wires are sticking out of
    the screen like guts. I didn't do this! I swear, I\u2019d remember. Someone,
    while I was gone, walked up to my desk, opened my private notebook, and drew
    this wild shit. The shame is so bad I want the floor to swallow me. Who saw it?
    Does the whole class know I\u2019m drawing schizo-crap now? And what if they
    read what I wrote before? Fuck, I\u2019m actually shaking. I feel naked. Someone
    crawled inside my head while I was taking a piss. I quickly covered the page
    with my elbow, sitting there with my face turning bright red.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
