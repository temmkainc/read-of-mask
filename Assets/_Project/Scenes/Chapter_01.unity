--- !u!114 &1693281870
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1693281867}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "We sat in the back row. The theater was dark, reeking of dampness, but
    I didn't give a fuck. She was sitting so close I could feel the heat from her
    jacket. My heart was hammering in my throat. At some point, I worked up the nerve...
    you know, like, now or never. I wanted to slowly put my hand on her knee. I\u2019d
    already reached out, my fingers trembling like that junkie\u2019s...\n\r\nAnd
    then I saw it. She leaned the other way, toward that piece of shit, and whispered
    something right into his ear, then gave him a playful shove and laughed. A way
    she never laughed with me. It felt like a hole had been blasted through my chest.
    I felt like such a nobody, such a blank space, that I just wanted to drop dead
    right there in that seat.\r\n\nAnd that\u2019s when I heard her again. The Principal,
    inside my skull, hissed coldly: <i><size=120%>Do you see? This is an animal.
    These are the filthy, senseless feelings of mannequins. Look at the screen. Look
    at the structure. Only there is there meaning.' </size>\n</i>\r\nI turned away
    from her. That's it, she\u2019s gone. There is only the screen. When they showed
    that stone face in a close-up, I suddenly understood. I looked at the subtitles\u2014nothing
    but a blur, letters swimming. But the voice inside prompted: 'Look through the
    slits.'\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
