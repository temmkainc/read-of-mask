  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The hand started moving again. \u041D\u043E this time the voice returned\u2014it\u2019s
    not screaming; it\u2019s sounding right inside my thoughts as if it\u2019s my
    actual self. The person I\u2019m supposed to become once I finally crawl out
    of this mess. I\u2019m writing it down word for word:\r\n\r\n'Look at yourself
    through my eyes. I am your higher will. I am your genius, your perfect project.
    What you saw was nothing but an echo of your animal beginnings, your fear of
    being a nobody. But you are not that boy in the mud. You are the Architect, building
    a better version of yourself. Forget the emotions and the chaos in your head.
    There is only me. Every drawing of yours is just an obstacle on the path to absolute
    clarity. You must rise above this trash. You are a pure idea, you are the Order
    that stands above the chaos of the flesh. Only through me will you become real.
    Only through my light will you cease to be mere accidental biological noise and
    become the Creator.'\r\n\r\nI\u2019m writing this and I can feel my chest growing
    cold and hollow, but this emptiness... it feels right. Like I\u2019m finally
    becoming something more."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
