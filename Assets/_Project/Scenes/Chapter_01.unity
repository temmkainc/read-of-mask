  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Three days. For three fucking days, I couldn\u2019t even pick up a pen.
    It\u2019s like the Principal\u2019s voice just cut my power. She said the system
    needed 'optimization,' and I just... froze. I sat in the corner, staring at the
    wall until those goddamn squares started flying in front of my eyes. I thought
    I\u2019d become perfect, but it turns out I just died.\r\n\r\nThen this morning,
    the spring snapped. I tried to get up, but my body felt like it was filled with
    lead. My hands were shaking like I\u2019d been on a week-long bender. When I
    tried to do a push-up, instead of the Principal's cold chime, I heard this wild
    hissing in my head\u2014like a TV cable being ripped out. And through that hiss:
    laughter. Quiet, nasty, right in my ear. I looked in the mirror and didn\u2019t
    see my face\u2014only white noise and those ironic mugs bleeding through the
    skin. Order is dead. My brain started spiraling so hard I almost jumped out the
    window just to make it stop.\r\n\r\nI\u2019m sitting in Geometry right now, and
    it\u2019s a total clusterfuck. I look at the board, and instead of triangles,
    there are those caricature freaks from the encyclopedia. They\u2019re blinking
    at me, braying; I can literally hear that paper rustling inside my skull. The
    teacher is barking something, and I can see pixels flying out of her mouth instead
    of words. Dirty, gray little squares. Just like in that game.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
