  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "During the break, she came up to me. Before, I probably would\u2019ve
    sweated like a dog and started stuttering, but now I just looked right through
    her. She started yapping about how 'wow, you really learned your history, maybe
    you can help me too,' and something else about that movie at the 'Cosmos'...
    But I stood there and saw not a face, but noise. Just redundant lip movements,
    hair getting in the eyes\u2014total disorder.\n\nI gave her the shortest answer
    possible: 'No help needed. Bye.' She just froze there with her mouth open, like
    her power had been cut. She looked at me like I was an alien, but I felt... nothing.
    The voice said she\u2019s just garbage that doesn\u2019t require a response.
    She\u2019s just biological mass clogging up my channel. I turned around and walked
    to the next classroom with steady steps. Didn't even look back. Geography's next."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
