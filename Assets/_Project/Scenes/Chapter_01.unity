  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'I tore and drew until the room turned into a junkyard of paper and ink.
    I looked at my journal entry from 08.04 and saw nothing but filth. Mom was banging
    on the door, screaming something, but I couldn''t hear the words. To me, her
    voice was just white noise. I watched through the wallpaper as Chaos leaked into
    the room, as the world crumbled into dirty pixels.



    The Principal went
    silent. She just burned out. All that''s left is that nasty, ironic laughter
    of Chaos.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
