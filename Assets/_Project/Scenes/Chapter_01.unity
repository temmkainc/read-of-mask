  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<i>I bailed and headed home.</i>I just couldn't be there anymore. Mom\u2019s
    at work; the house is dark and so quiet that my ears are actually ringing. <i>I
    lay down on the bed still wearing my jacket, didn't even take off my sneakers\u2014I
    just didn't have the strength.</i> The CAT came over, curled up somewhere by
    my side, warming me through my sweater and <i>just breathing.</i> It\u2019s the
    only thing right now that doesn't piss me off.\r\n<i>I pulled out a pencil, thinking</i>I'd
    draw something from that textbook, but my hand just started... <i>Her, again.
    I see her face when I close my eyes; I see how the sun from the window hit her
    cheek.</i> On paper, it just looks like a bunch of smudges; I can\u2019t capture
    how she actually looks. The pencil screeches; <i>I\u2019m pressing so hard the
    paper is buckling.</i>\r\nI want to write her name under the drawing, but my
    fingers feel like they\u2019ve turned to wood. I\u2019m afraid to even write
    it here, in this journal. If someone sees this... "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
