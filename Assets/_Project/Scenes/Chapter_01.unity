  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I was walking past that newsstand with the poster for that Italian movie
    on the wall. The stone face with a hole instead of a mouth\u2014the 'Mask of
    Truth,' or whatever it's called. And then, the same glitch again. The guy with
    the TV-head was standing right under the poster. Just for a second, literally.\r\nI
    stopped dead in my tracks, my heart stuck in my throat, but then this surge of
    rage just hit me... I just raised my hand and flipped him the bird. 'Go to hell!'
    I hissed. And what do you think happened? The creature raises its own hand and
    slowly shows me the exact same thing back. One for one. And then\u2014bam\u2014he\u2019s
    gone. Just empty space by the wall, only the wind blowing some newspaper around.
    What kind of fuckery is this?! I started spiraling for real; I almost collapsed
    right there by the poster.\r\nI dragged myself to school; I\u2019m sitting in
    class now, and my hands are still shaking. She\u2019s sitting in front of me,
    her hair smells like some kind of shampoo, and I\u2019m just staring at my own
    fingers, not understanding..."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
