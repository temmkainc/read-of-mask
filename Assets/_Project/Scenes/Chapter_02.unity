--- !u!114 &2061714037
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2061714034}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My hand is drawing these heads right over my notes on its own; I can\u2019t
    stop it\u2014it\u2019s like it\u2019s plugged into some other controller. The
    whole class is staring at me because I\u2019m probably breathing like a steam
    engine or twitching. The Principal\u2019s voice is somewhere back there, behind
    all this white noise, trying to scream: 'Maintain the structure! Delete the noise!'
    but she\u2019s barely audible over the laughter. These heads... it\u2019s like
    they\u2019re gnawing through the paper. I feel like if I don\u2019t bail right
    now, I\u2019m just going to start screaming white noise right into that fat cow\u2019s
    face at the chalkboard. Need to get home."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
