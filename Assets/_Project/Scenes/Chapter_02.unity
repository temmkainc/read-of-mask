  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I can hear the key turning in the lock. My stomach still hurts and my
    mouth is still burning. Mom\u2019s back. She slammed the door so hard it made
    my teeth clench. Pissed off as a dog again. The smell of burnt food is crawling
    down the hallway, so nauseating it makes my stomach churn even more.\r\nThat\u2019s
    it, I\u2019m hiding this notebook. I\u2019d better go eat whatever she\u2019s
    cooked up and then play dead. It\u2019s simpler that way. That way, nobody touches
    me. Tomorrow, it's the same thing all over again."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
