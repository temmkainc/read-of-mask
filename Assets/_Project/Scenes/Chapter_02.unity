  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I\u2019m sitting in the darkness now. Torn pages are everywhere. The TV-man
    is watching me from the screen, silent. That\u2019s all I see. I don\u2019t want
    to be a mannequin anymore. I don\u2019t want to be a model. I want to be this
    laughter. All that\u2019s left is this glitch.\r\n\r\nI\u2019m writing this,
    and my fingers... they feel like they\u2019re crumbling into pixels."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
