  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"I\u2019m sitting at home now, and this isn\u2019t a room anymore\u2014it\u2019s
    some kind of glitched-out level. I\u2019m holding a pen, and it feels like a
    wire running somewhere deep under my skin. Right in front of me, perched on my
    desk, I see the TV-head\u2014he\u2019s sprawled out on my bed, and this caustic,
    gray laughter is pouring out of his screen. He doesn\u2019t say a word; he just
    broadcasts those ironic mugs directly into my eyes.\r\n\r\nAnd the Principal...
    she\u2019s not just whispering anymore; she\u2019s bellowing from the very foundation
    of my skull. 'DESTROY HIM!' she shrieks so loud my teeth feel like they're starting
    to crumble. 'HE IS RUINING THE CYCLE! HE IS A VIRUS! HE IS AN ERROR THAT MUST
    BE DELETED!' She\u2019s demanding that I grab a knife or at least smash the screen\u2014that
    I purge this noise and bring back the perfect silence.\r\n\r\nBut the Guy just
    tilts his glass head, and static ripples across him like he\u2019s mocking me.
    I look at my own hands: one hand is clenched into a fist until the knuckles are
    white\u2014that\u2019s Her. The other is drawing those moronic heads on the wallpaper,
    one after another\u2014that\u2019s Him. I\u2019m stuck in the middle, and I\u2019m
    literally being ripped to pieces. They want to kill each other, but they\u2019re
    going to kill me."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
