  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I think something happened to me during these past few days. Words don't
    obey me anymore. When I look at them for too long, they start to break.\r\n\r\nThe
    letters crawl apart and start to look like those tiny heads I used to draw in
    the margins. Maybe I invented them myself. Or maybe they were always here. I
    tried to read the old pages, but I couldn't. It\u2019s as if someone else wrote
    them."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
