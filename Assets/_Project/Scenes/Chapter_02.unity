  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Today at school, it was the same old bullshit again. I was standing in
    the hallway, minding my own business, when that half-wit and his crew knocked
    the bag right out of my hands. Everything scattered across the floor... notebooks,
    keys, some spare change. The whole hall was howling with laughter. I just stood
    there and watched them stomp all over my things. Inside, everything was burning;
    I wanted to grab something heavy and smash it into his face. But I didn''t do
    a thing... Again...


    <size=120%>

    I just stared into the <size=130%><b>camera</b>
    </size>lens above the principal''s door. That little box was glaring at me, like
    it was just waiting for me to snap. I grit my teeth so hard my jaw still aches.
    I gathered my stuff and left. The principal watched through the glass of her
    door, adjusting her glasses. Didn''t say a word. They all love it when I''m this
    ''convenient.'' I was like a mannequin.</size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
