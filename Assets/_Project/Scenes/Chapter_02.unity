  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "At school, things went south fast. I sat in class and opened my textbook,
    and it looked like someone had dumped ink into an aquarium. The letters won\u2019t
    stay still. I look at a sentence, trying to hook just one familiar word, but
    they fuse together right before my eyes, twisting into those ironic heads. One
    line is a smirk; the next is a snarl. I rub my eyes until I see sparks, but it
    won\u2019t go away. The Principal hisses in the back of my head: 'Read! This
    is the structure! This is the foundation!' but I can\u2019t, because to me, it\u2019s
    just a bunch of icons now.\n\nWhen the teacher asked something about subjects
    and predicates, I just stared at her. I saw her lips moving, I heard the sounds,
    but they wouldn't form a meaning. It was just white noise, like a TV when the
    cable\u2019s loose. I wanted to answer, but I realized the words in my mouth
    had turned into heavy stones. I\u2019ve forgotten how to assemble them. All these
    morons around me were taking notes, pens scratching away, while I sat over my
    defaced notebook and watched a completely different language emerge from beneath
    the printed letters. A language where, instead of rules, there are only these
    crooked, ironic mugs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
