  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Going to bed. Recording the time\u201422:00. Protocol followed. The house
    is silent; only the fridge is rattling, as always. I look at the console under
    the bed. Silent. The old 'Elektron' is black\u2014a dead picture tube. I\u2019ve
    turned everything off. Even the radio. No voices. I\u2019ve finally defeated
    the noise.\r\n\r\nI close my eyes and see only straight lines and emptiness.
    The world has become clear. I have become clear. The voice in my head has gone
    silent\u2014she is satisfied. I am satisfied.\r\n<i><size=120%>\r\nBut... why,
    in this sterile silence, do I still hear someone laughing ironically somewhere
    very far away, through the walls and through time? And it feels like it\u2019s
    that same TV-guy. He\u2019s just sitting there, waiting. Maybe I\u2019m just
    moving too fast? But fuck it. That\u2019s it, sleep.</i></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
