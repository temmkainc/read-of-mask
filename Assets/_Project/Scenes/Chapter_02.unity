  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "If someone ever reads this notebook...\r\nMaybe you can. Maybe you can
    go where I no longer can.\r\nIf you see these heads in the margins\u2014do not
    ignore them. They aren't just scribbles. They are what remains of words.\r\nMaybe
    they will help you understand what happened to me.\r\nBecause I\u2019m already
    starting to vanish.\r\n\r\nSometimes it feels like I\u2019m looking at the world
    from a great distance.\r\nAs if I\u2019ve stayed behind, somewhere deep inside
    my head,\r\nwhile everything else moves on without me.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
