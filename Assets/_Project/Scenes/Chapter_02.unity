--- !u!114 &2068596076
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2068596073}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I bolted home and locked every single bolt. My hands were shaking so hard
    I could barely jam that bare cartridge into the slot. I flipped on the 'Elektron,'
    and it didn't just hum\u2014it growled. The sound was like someone sawing through
    concrete with an angle grinder behind the wall.\r\n\r\nAnd then, instead of the
    PERSON2 logo, HE crawled onto the screen. The TV-headed man. Only now, he wasn\u2019t
    standing in the corner; he was right there, inside the picture tube, sitting
    in a chair that looked exactly like mine. He picked up a controller, and I felt
    my own fingers tighten around the plastic. I\u2019m not playing the game\u2014he\u2019s
    playing ME.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
