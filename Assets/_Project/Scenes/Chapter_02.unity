  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "And then, I finally lost it. I grabbed that goddamn 'Encyclopedia for
    Boys'\u2014the Principal\u2019s holy bible, where everything is in its place,
    everything perfect. I started tearing it apart. I ripped out the pages on 'etiquette'
    and social conduct, tossing them into the air like snow.\r\n\r\nThen I took a
    black marker and started drawing. I drew those ironic, scribbled heads over the
    'perfect boys' in their suits, right over their proper faces. I gave them third
    eyes, snarling maws, wires sticking out of their ears. The Principal\u2019s voice
    in my head turned into ultrasound; she was shrieking: 'ERROR! SYSTEM CRASH! ABORT!'\r\n\r\nBut
    the TV-man on the screen just sat there, ironically applauding."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
