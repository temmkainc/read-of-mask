  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<i>if they find out what I think about her\u2014I\u2019m finished. I\u2019m
    a total zero. I can\u2019t even draw her right; my hands are useless. </i>I\u2019m
    just lying here, petting the cat, wishing this day could just be erased from
    my MEMORY like a bad sketch with an eraser. I hope nobody ever finds this notebook.
    I hope I just disappear myself."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
