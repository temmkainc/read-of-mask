  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sometimes it feels like they\u2019ve always been with me. \n\nBut why
    didn't I see them before?\n\nMaybe they\u2019re just two parts of me, trying
    to explain something.\n\nI\u2019m tired. It\u2019s become very quiet in my head.\n\nSo
    quiet that I\u2019ve started hearing other things.\n\nMemories.\n\nThey lie somewhere
    deep down. Like shards. I see them, but I can\u2019t put them back together.\nIt\u2019s
    as if inside me, there\u2019s a vast place full of rooms."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
