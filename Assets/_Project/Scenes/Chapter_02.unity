  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Those ironic heads started crawling across the screen\u2014thousands,
    millions of them, clogging the loading bar until it burst into black ink. The
    Principal was screaming inside my head so loud that blood dripped from my nose
    right onto the controller. She was shrieked: 'REBOOT! DELETE HIM!' But the TV-guy
    just tilted his glass head, and through the white noise, I heard: 'But why? Look
    at the pretty picture.'\n\nThe screen began to pulse in time with my heartbeat,
    and I realized\u2014Chaos doesn't want to break me. It just wants me to finally
    see that all this 'Order' is nothing but crooked code on a scratched disc."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
