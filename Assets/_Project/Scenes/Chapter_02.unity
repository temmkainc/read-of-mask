  _nagEntries:
  - Delay: 0
    Voiceline: {fileID: 0}
    DebugText: "\u0422\u0438 \u0432\u0438\u0439\u0448\u043E\u0432 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0456 \u043F\u0456\u0448\u043E\u0432 \u0434\u043E \u0432\u0430\u043D\u043D\u043E\u0457
      \u043A\u0456\u043C\u043D\u0430\u0442\u0438."
  - Delay: 8
    Voiceline: {fileID: 0}
    DebugText: "\u042F \u043F\u043E\u0432\u0442\u043E\u0440\u044E \u2014 \u0442\u0438
      \u0432\u0438\u0439\u0448\u043E\u0432 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0456 \u043F\u0456\u0448\u043E\u0432 \u0434\u043E \u0432\u0430\u043D\u043D\u043E\u0457
      \u043A\u0456\u043C\u043D\u0430\u0442\u0438."
  - Delay: 15
    Voiceline: {fileID: 0}
    DebugText: "\u041D\u0435 \u0437\u043C\u0443\u0448\u0443\u0439 \u043C\u0435\u043D\u0435
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u0438 \u0446\u0435\u0439 \u0434\u0435\u043D\u044C
      \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443."
  _narratorAudioSource: {fileID: 0}
  _restartAfterStalling: 1
  _stallRestartDelay: 10
  _expectedActionIds:
  - BathroomDoor
  _correctionVoiceline: {fileID: 0}
  _correctionDebugText: "\u0422\u0438 \u0440\u043E\u0431\u0438\u0432 \u043D\u0435
    \u0446\u0435. \u0422\u0438 \u043F\u0456\u0448\u043E\u0432 \u0443 \u0432\u0430\u043D\u043D\u0443."
  _correctionDelay: 2
