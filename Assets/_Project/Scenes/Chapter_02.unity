  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I came home. The apartment was... empty. Perfectly empty. Not a whiff
    of cheap hairspray or burnt food. Not a sound, except for the fridge. Mom was
    sitting in the kitchen. Sober. Clean. She\u2019d even cooked a normal dinner\u2014actual
    potatoes, not that blueish mush she usually makes.\r\nShe looked at me, and there
    was something... strange in her eyes. Like she wanted to say something, maybe
    apologize for being gone for three days. Before, I probably would\u2019ve been
    happy; I\u2019d have hugged her, started asking questions. But now, I just walked
    right past. I sat at the table, picked up a fork, and started eating. She sat
    down, too.\r\nWe ate in total silence. Zero emotion. This didn't feel like her,
    and it sure as fuck didn't feel like me. Not a word. Not a single wasted movement.
    Only the sound of metal hitting the plate. She opened her mouth a few times but
    never said a thing. She just watched as I mechanically chewed my food. It felt...
    right. No noise. No emotions. Just fuel consumption.\r\nThe Principal\u2019s
    voice in my head quietly confirmed: 'Subject \u21162: Nominal operating mode.
    Order established. Weakness deleted.' Even the cat didn't show up. I haven't
    seen him in a long time...\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
