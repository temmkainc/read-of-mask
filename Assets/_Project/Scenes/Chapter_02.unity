  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The evening block went like clockwork. Not a single hitch in my breathing,
    not a drop of sweat. The body is just a tool, a piece of iron executing a command.
    Before, I used to whine about my muscles burning, but now I just watch them contract
    under the skin. It\u2019s not pain; it\u2019s just a load-bearing exercise to
    make me perfect.\n\r\nThe Principal\u2019s voice has become so clear, like crystal
    in an empty hall. 'A perfect form,' she whispered to me..."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
