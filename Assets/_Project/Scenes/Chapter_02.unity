  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "After class, I trudged to the cafeteria. It reeks of burnt cutlets and
    that sour smell that always makes me gag. Then I saw her. She was sitting with
    her friends at the far table. I don\u2019t know what came over me, but I just
    sat down nearby. Well, not right with them, but one chair over. And I just froze.
    My mouth went bone-dry, like I\u2019d eaten a handful of sand. I just stared
    at my plate of this slimy rice and sat there mute like a moron.\n\n\n\n\r\n<size=120%>And
    they started braying. Suddenly, and so loud. I felt it in my back\u2014them looking
    at me. They\u2019re definitely LAUGHING at me. Because I showed up, because I\u2019m
    silent, because I look like shit. I couldn't even lift my head; I just gripped
    my fork so hard my knuckles turned white. I wanted the ground to open up and
    swallow me whole. She was laughing too. The worst part is, I still can\u2019t
    tell if she\u2019s one of them or if she just thinks it's funny how pathetic
    I am.</size>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
