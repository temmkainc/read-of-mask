--- !u!114 &1423129847
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1423129844}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "That\u2019s it, I\u2019m out. Feels like I haven\u2019t left this room
    in three days, and in that time, I\u2019ve managed to completely fry my brains.
    My eyes are burning like someone dumped a handful of sand in them, and everything
    in front of the screen is just a blur. Mom never showed back up; she vanished
    that same night. Probably out roaming somewhere with that guy of hers\u2014fuck
    her, at least nobody was in my way.\r\nI\u2019ve played so much that I think
    I actually killed the TV: the picture on the 'Elektron' has gone totally grey
    and grainy, and it's started twitching in this creepy way. But that\u2019s not
    even the worst part. About an hour ago, while I was sitting in total darkness
    mashing the buttons, I felt it in my back\u2014someone else was in the room.\n\nI
    turned around for a second and nearly shat myself. In the corner by the wardrobe,
    it looked like some guy was standing there... tall, like a mannequin, but instead
    of a head, he had a goddamn television flickering with white noise. I blinked,
    rubbed my eyes, and it was gone\u2014just a pile of clothes on the chair. But
    my heart is still pounding in my throat. This is it, the finish line. I definitely
    need to sleep because my mind is officially snapping. Turning everything the
    fuck off. I'm done.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
  m_sharedMaterial: {fileID: 1302324160900633244, guid: 45ae1b20a8af0b947bf46692f07a66b7, type: 2}
