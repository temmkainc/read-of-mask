  m_Script: {fileID: 11500000, guid: d6c85a3737ee45045a8733c6aeacbd96, type: 3}
  m_Name: Radio_WeatherForecast
  m_EditorClassIdentifier: Assembly-CSharp::VoicelineData
  Id: radio_weather_forecast
  AudioClip: {fileID: 8300000, guid: eb37065fe1ba29e4eb55d995c9296323, type: 3}
  Subtitles:
  - startTime: 3.1573334
    endTime: 5.0346665
    text: ' According to the Forecast Center'
  - startTime: 5.0346665
    endTime: 6.592
    text: ' the weather across the country will be '
  - startTime: 6.592
    endTime: 8.448
    text: shaped by a high-pressure system
  - startTime: 8.448
    endTime: 10.368
    text: moving in from Central Europe
  - startTime: 10.368
    endTime: 11.906
    text: Expect cloudy skies
  - startTime: 11.906
    endTime: 13.57
    text: ' with occasional clear spells.'
  - startTime: 13.975333
    endTime: 15.426
    text: ' Most regions will see no '
  - startTime: 15.426
    endTime: 16.897999
    text: significant precipitation
  - startTime: 16.95
    endTime: 18.784668
    text: though brief sleet is possible
  - startTime: 18.784668
    endTime: 20.128668
    text: ' during the night'
  - startTime: 20.128668
    endTime: 23.051334
    text: and morning hours in the Carpathian region.
  - startTime: 23.55
    endTime: 25.363333
    text: Icy conditions will persist
  - startTime: 25.363333
    endTime: 26.472666
    text: on the roads,
  - startTime: 26.472666
    endTime: 29.139332
    text: ' mostly at night, so drivers are urged to be careful.'
  - startTime: 29.139332
    endTime: 32.915333
    text: Well, some of you will stay careful, some will not
  - startTime: 32.915333
    endTime: 34.131332
    text: "we\u2019ll see! "
  - startTime: 34.24
    endTime: 36.666668
    text: The weather in our city changes at warp speed,
  - startTime: 36.666668
    endTime: 39.440002
    text: and honestly, so does our mood.
  - startTime: 39.440002
    endTime: 42.17067
    text: ' So, to keep your emotional climate stable,'
  - startTime: 42.17067
    endTime: 45.776005
    text: just take a deep breath and stay tuned to our station!
  - startTime: 48.61334
    endTime: 50.91734
    text: So? You didn't think...
  - startTime: 51.515335
    endTime: 53.414
    text: ' I would leave you all alone,'
  - startTime: 53.414
    endTime: 54.758003
    text: ' did you?'
  - startTime: 55.398003
    endTime: 57.073334
    text: ' I''m always here.'
  - startTime: 57.47
    endTime: 58.835335
    text: No, stop...
  - startTime: 58.835335
    endTime: 60.07267
    text: ' What is this?!'
  - startTime: 60.07267
    endTime: 62.718002
    text: " The chaos... it\u2019s consuming me!"
  - startTime: 62.718002
    endTime: 65.10734
    text: ' I... I can''t stay here this long!'
  - startTime: 65.17
    endTime: 66.94067
    text: I'm so cold...
  - startTime: 67.44
    endTime: 69.63734
    text: 'Find me! '
