  m_Script: {fileID: 11500000, guid: d6c85a3737ee45045a8733c6aeacbd96, type: 3}
  m_Name: Headmistress_Portrait
  m_EditorClassIdentifier: Assembly-CSharp::VoicelineData
  Id: headmistress_portrait_interaction
  AudioClip: {fileID: 8300000, guid: 916982aed0e956e4996ea5aca4c1aac6, type: 3}
  Subtitles:
  - startTime: 0.256
    endTime: 1.5786667
    text: Do you like it?
  - startTime: 2.4746666
    endTime: 4.7999997
    text: This is a mirror.
  - startTime: 5.802666
    endTime: 9.365333
    text: ' I came out quite well in this painting.'
  - startTime: 10.474666
    endTime: 11.892667
    text: ' A perfect form, '
  - startTime: 12.04
    endTime: 16.244667
    text: without the unnecessary filth of emotion.
  - startTime: 17.7
    endTime: 20.490002
    text: ' I see your future in this canvas...'
  - startTime: 21.43
    endTime: 24.260666
    text: if, of course, you want to become
  - startTime: 24.260666
    endTime: 27.449333
    text: 'at least half as flawless as I am. '
