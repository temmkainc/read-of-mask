  m_Name: Headmistress_BookOnCoffeeTableReaction
  m_EditorClassIdentifier: Assembly-CSharp::VoicelineData
  Id: book_coffee_table_reaction
  AudioClip: {fileID: 8300000, guid: 49cfb1564e9dcdd4299d8077692219d9, type: 3}
  Subtitles:
  - startTime: 0.43
    endTime: 3.9893334
    text: Do you really think it looks better on the coffee table?
  - startTime: 5.7599998
    endTime: 8.234667
    text: You are trying to decorate your mess
  - startTime: 8.234667
    endTime: 10.773334
    text: instead of structuring it.
  - startTime: 10.773334
    endTime: 13.162667
    text: Books belong in rows,
  - startTime: 13.162667
    endTime: 16.392
    text: 'not lying around wherever they fall. '
